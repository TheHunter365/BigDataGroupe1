# CORE HADOOP
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec
CORE_CONF_hadoop_http_staticuser_user=root

# HDFS
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_replication=2

# YARN
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_log_aggregation_enable=true
YARN_CONF_yarn_nodemanager_aux_services=mapreduce_shuffle

# YARN MEMORY
YARN_CONF_yarn_nodemanager_resource_memory_mb=4096
YARN_CONF_yarn_nodemanager_resource_cpu_vcores=2

# MAPREDUCE
MAPRED_CONF_mapreduce_framework_name=yarn
MAPRED_CONF_mapreduce_map_memory_mb=1024
MAPRED_CONF_mapreduce_reduce_memory_mb=2048
MAPRED_CONF_mapreduce_map_java_opts=-Xmx800m
MAPRED_CONF_mapreduce_reduce_java_opts=-Xmx1500m
MAPRED_CONF_mapreduce_map_output_compress=true
MAPRED_CONF_mapred_map_output_compress_codec=org.apache.hadoop.io.compress.SnappyCodec